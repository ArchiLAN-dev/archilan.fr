API_KEY=                           # même valeur que ORCHESTRATEUR_API_KEY
BRIDGE_TOKEN=                      # même valeur que BRIDGE_INTERNAL_TOKEN
PORT_RANGE_START=25000
PORT_RANGE_END=25099
DB_PATH=/data/orchestrateur.db
DOCKER_HOST=unix:///var/run/docker.sock
BRIDGE_IMAGE=ghcr.io/archilan-dev/bridge:0.12.2
# Cloisonnement des sessions (story 50.2) : trois reseaux internes, sans acces a Internet.
#   archilan-sessions  : serveurs Archipelago et bridges, rien d'autre
#   archilan-callbacks : bridges et API
#   archilan-ap-edge   : serveurs Archipelago et Traefik (PROXY_NETWORK plus bas)
BRIDGE_NETWORK=archilan-sessions
BRIDGE_CALLBACK_NETWORK=archilan-callbacks

# Exposition du serveur Archipelago (epic 37). En production Traefik est la seule socket publique
# d'une run : il termine le TLS et joint le conteneur par son nom sur le réseau du proxy, donc le
# port n'est plus publié sur l'hôte. Les deux désactivés à la fois sont refusés au démarrage
# (aucune run ne serait joignable). En dev local, garder AP_PUBLISH_HOST_PORT=true : il n'y a pas
# de proxy.
AP_PUBLISH_HOST_PORT=false
# Le proxy doit etre branche sur ce reseau, a verifier avant toute bascule :
#   docker inspect traefik --format '{{json .NetworkSettings.Networks}}'
# Sinon il ne peut pas joindre le conteneur de session et la run est injoignable alors que la
# session parait saine. Ne pas remettre `traefik` : tout le reste de l'hote est dessus.
PROXY_NETWORK=archilan-ap-edge

# Publication du port REST du bridge (story 37.7, phase 2).
# L'API le joint desormais par son nom de conteneur sur le reseau interne : le port n'a plus de
# consommateur, et sa fermeture referme la derniere socket publique d'une run.
# A ne basculer qu'APRES avoir verifie qu'une run existante repond toujours (etat des slots, hints,
# archivage) - sinon l'API perd l'acces a tous les bridges.
BRIDGE_PUBLISH_HOST_PORT=false
WEBHOOK_URL=http://api-web/api/v1/internal/orchestrateur/webhook
WEBHOOK_SECRET=                    # même valeur que ORCHESTRATEUR_WEBHOOK_SECRET
CENTRAL_API_URL=http://api-web
CENTRAL_API_SECRET=                # même valeur que CENTRAL_API_SECRET
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=archilan-minio
MINIO_SECRET_KEY=                  # même valeur que MINIO_ROOT_PASSWORD
MINIO_USE_SSL=false
MINIO_BUCKET_APWORLDS=apworlds
MINIO_BUCKET_SESSIONS=sessions
AP_IMAGE=ghcr.io/archilan-dev/archipelago:0.14.0
AP_SERVER_PORT_OFFSET=10000
CORS_ORIGINS=https://archilan.fr
