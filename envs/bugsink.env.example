# Story 33.32 : Bugsink, remontée des erreurs. Mise en service : docs/remontee-erreurs.md.

# openssl rand -base64 50
SECRET_KEY=
# Base `bugsink` dans le Postgres d'ArchiLAN, avec son propre rôle (créés à la main, voir la doc).
DATABASE_URL=postgresql://bugsink:MOT_DE_PASSE@postgres:5432/bugsink
# Premier compte admin, créé au premier démarrage puis à retirer d'ici : email:motdepasse
CREATE_SUPERUSER=
TIME_ZONE=Europe/Paris
SITE_TITLE=ArchiLAN - erreurs
# Pas de statistiques d'usage envoyées à l'éditeur de Bugsink (actif par défaut).
PHONEHOME=False

# Comptes : une seule équipe, invitations par un admin seulement, pas d'inscription libre.
SINGLE_TEAM=True
USER_REGISTRATION=CB_ADMINS
TEAM_CREATION=CB_ADMINS

# Garde-fous : une erreur en boucle ne remplit ni le disque ni la base.
MAX_EVENTS_PER_PROJECT_PER_5_MINUTES=500
MAX_EVENTS_PER_PROJECT_PER_HOUR=2000
MAX_RETENTION_PER_PROJECT_EVENT_COUNT=10000
MAX_EVENT_AGE_DAYS=90
MAX_EMAILS_PER_MONTH=500

# Alertes par mail (SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ArchiLAN erreurs <noreply@archilan.fr>
