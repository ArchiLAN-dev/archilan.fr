# Story 41.43 : app de blind test (dépôt archilan-blind-test). Copier en envs/blind-test.env.
APP_SECRET=                        # openssl rand -hex 32
# Même valeur que BLIND_TEST_SHARED_SECRET dans envs/api.env.
BLIND_TEST_SHARED_SECRET=
# Ouvre la régie et l'écran de salle : https://BLIND_TEST_DOMAIN/regie?token=... (vide = fermés).
# Story 41.53 : les admins d'archilan.fr entrent avec leur compte. Ce code reste un secours facultatif pour les PC de la
# salle sans compte admin (sono, projecteur) ; vide = connexion admin seulement.
REGIE_TOKEN=                       # openssl rand -hex 16
TRUSTED_PROXIES=private_ranges
# Le site vu par le navigateur des joueurs : l'app y renvoie pour la connexion (story 41.45).
SITE_PUBLIC_URL=https://archilan.fr
# Story 41.52, facultatif : clé YouTube Data API v3 (Google Cloud). Vérifie les vidéos par 50 et donne leurs vues,
# pour le réglage « Vues minimales ». Vide : vérification sans clé, une vidéo à la fois.
YOUTUBE_API_KEY=
