# ─── Symfony core ────────────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=                        # php -r "echo bin2hex(random_bytes(32));"
EMAIL_HASH_SECRET=                 # php -r "echo bin2hex(random_bytes(32));"

# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://archilan:POSTGRES_PASSWORD@postgres:5432/archilan?serverVersion=17&charset=utf8

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
MESSENGER_TRANSPORT_DSN=amqp://archilan:RABBITMQ_PASSWORD@rabbitmq:5672/%2f
MESSENGER_FAILED_TRANSPORT_DSN=amqp://archilan:RABBITMQ_PASSWORD@rabbitmq:5672/%2f

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=                    # openssl rand -hex 32

# ─── Mercure ─────────────────────────────────────────────────────────────────
MERCURE_URL=http://mercure:3001/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.archilan.fr/.well-known/mercure
MERCURE_JWT_SECRET=                # même valeur que MERCURE_PUBLISHER_JWT_KEY

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_PRESIGN_ENDPOINT=https://minio.archilan.fr
MINIO_ACCESS_KEY=archilan-minio
MINIO_SECRET_KEY=                  # même valeur que MINIO_ROOT_PASSWORD
MINIO_BUCKET_APWORLDS=apworlds
MINIO_BUCKET_SAVES=sessions
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_MEDIA_PUBLIC=media-public
# Public base URL for stable (CDN-cacheable) public image URLs, mapped to the media-public bucket.
# Leave empty to fall back to presigned URLs against the public bucket (works, but URLs rotate).
MINIO_PUBLIC_MEDIA_BASE_URL=https://media.archilan.fr
MINIO_PRESIGN_TTL_SECONDS=3600

# ─── Orchestrateur ───────────────────────────────────────────────────────────
RUNNER_BASE_URL=http://orchestrateur:8000
RUNNER_PUBLIC_HOST=orchestrateur.archilan.fr
ORCHESTRATEUR_API_KEY=             # openssl rand -hex 32
ORCHESTRATEUR_WEBHOOK_SECRET=      # openssl rand -hex 32
CENTRAL_API_SECRET=                # openssl rand -hex 32
BRIDGE_INTERNAL_TOKEN=             # openssl rand -hex 32

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://archilan.fr
DEFAULT_URI=https://api.archilan.fr

# ─── Mailer ──────────────────────────────────────────────────────────────────
MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_SENDER=noreply@archilan.fr

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID_ADMIN=
DISCORD_ROLE_ID_MEMBER=
DISCORD_REDIRECT_URI_AUTH=https://api.archilan.fr/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI_LINK=https://api.archilan.fr/api/v1/account/discord/link/callback

# ─── Twitch ──────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=archilan

# ─── HelloAsso ───────────────────────────────────────────────────────────────
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_SANDBOX=false
HELLOASSO_MEMBERSHIP_FORM_SLUG=
HELLOASSO_SHOP_FORM_SLUG=
# Story 41.13: the HelloAsso donation form (the number in .../formulaires/{n}); empty = no donation block.
HELLOASSO_DONATION_FORM_SLUG=

# ─── Infra ───────────────────────────────────────────────────────────────────
# Meme valeur que le token du provider HTTP cote proxy.
TRAEFIK_TOKEN=
# Nom du certresolver tel qu'il est declare dans le proxy. Un nom inconnu de Traefik ne
# provoque aucune erreur : il sert son certificat par defaut, et le navigateur refuse.
TRAEFIK_CERT_RESOLVER=https
WORKSPACE_DIR=/var/archilan/workspace
ARCHIVE_DIR=/var/archilan/archives
ARCHIPELAGO_GENERATE_IMAGE=ghcr.io/archilan-dev/archipelago:latest
DOCKER_HOST=unix:///var/run/docker.sock

# --- Apworlds: version watch and automatic update (stories 14.5, 38.5, 38.6, 38.9, 38.11) ---
# GitHub token (read-only, public repos). Without it the nightly version check is skipped entirely
# (a single `github.token_missing` warning in the worker logs), so nothing is ever updated.
GITHUB_TOKEN=
# Updates submitted per nightly pass at most (default 10, 0 turns the automatic update off).
# On demand: `php bin/console app:check-apworld-updates --submit [--limit=N]`.
APWORLD_AUTO_UPDATE_BATCH_SIZE=10
# Apworlds retested each night by the rolling catalogue test (default 25, 1 to 200).
APWORLD_SWEEP_BATCH_SIZE=25
# Incoming webhook of the staff channel for apworld incident alerts. Empty = no Discord alert.
DISCORD_STAFF_WEBHOOK_URL=
# Channel where the bot (DISCORD_BOT_TOKEN) announces the week's quests (stories 41.24, 41.26); the bot needs to
# send messages and embed links there. Empty = no Discord message.
DISCORD_QUESTS_CHANNEL_ID=

# --- Moderation on Discord (epic 39) ---
# Two independent switches, both off by default. The bot is the project's existing one (DISCORD_BOT_TOKEN,
# DISCORD_GUILD_ID, already used for the roles).
#
# 1) Staff forum: each member's moderation case has a post there (sanctions, member messages, staff
#    replies). Empty = no forum. The bot needs, on that forum channel: view the channel, create posts,
#    send messages in threads, manage threads. Tags "Avertissement", "Suspension", "Ban", "Levée" are
#    applied when they exist.
DISCORD_MODERATION_FORUM_ID=
# 2) Synchronisation with the server (1 = on): DM to the member on each sanction and staff reply, member
#    answers read every minute, site ban = Discord ban, suspension = Discord timeout (extended every night
#    past Discord's 28 days), lift = unban and end of timeout, bans posed on Discord applied to the linked
#    site account every 5 minutes. Only accounts linked to Discord on the site are concerned.
#    Bot permissions on the server: Ban Members, Moderate Members (timeout), View Audit Log (who banned);
#    the bot's role must sit above the members' roles.
#    FIRST PASS after switching on: the bans already on the server are shown once in the staff forum, one
#    post each, "to decide", and never applied to the site.
#    A job still failing after its retries is parked: `php bin/console messenger:failed:show` / `:retry`.
DISCORD_MODERATION_SYNC=0

# --- Browser push notifications (story 40.2) ---
# The site's VAPID key pair (push services check every push against it) and a contact they may use.
# Empty = pushes off (the account card says so). Generate the pair ONCE, in the api-web container:
#   php bin/console app:web-push:generate-keys
# A new pair logs every subscribed device out of pushes. Keep the private key secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contact@archilan.fr
