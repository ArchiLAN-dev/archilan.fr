# traefik/.env - variables lues par docker compose ET par scripts/gen-traefik-config.sh.
# Copier en traefik/.env sur le serveur. Jamais commité (voir .gitignore).

# ─── ACME / Let's Encrypt (DNS-01 OVH) ──────────────────────────────────────────
ACME_EMAIL=admin@archilan.fr

# OVH API - https://www.ovh.com/auth/api/createToken
# Droits requis : GET/POST/PUT/DELETE sur /domain/zone/*
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# ─── Plage de ports des serveurs Archipelago ────────────────────────────────────
# Mêmes valeurs que celles de l'orchestrateur (.env.prod). Le port d'un serveur Archipelago vaut
# `port du pool + offset` : avec les valeurs ci-dessous, Traefik ouvre 35000-35099.
# Toute modification impose de régénérer (scripts/gen-traefik-config.sh) ET de redémarrer Traefik.
PORT_RANGE_START=25000
PORT_RANGE_END=25099
AP_SERVER_PORT_OFFSET=10000

# ─── Provider HTTP (routeurs des sessions, produits par l'API) ──────────────────
# Même valeur que TRAEFIK_TOKEN côté API (envs/api.env) : c'est le secret partagé qui authentifie
# la requête sur /api/v1/internal/traefik.
# Éviter le caractère `$` dans le token : docker compose interpole les valeurs de ce fichier et
# avalerait `$xxx` (il faudrait l'écrire `$$`). Le générateur, lui, lit la valeur littéralement.
TRAEFIK_TOKEN=
# Joint par le réseau interne archilan-proxy, pas par le nom public : Traefik ne doit pas dépendre
# de son propre routage pour aller chercher sa configuration.
TRAEFIK_HTTP_PROVIDER_ENDPOINT=http://archilan-api-web/api/v1/internal/traefik
TRAEFIK_HTTP_PROVIDER_POLL_INTERVAL=5s
TRAEFIK_HTTP_PROVIDER_POLL_TIMEOUT=5s
