# Copier en .env (jamais commité) et adapter à la LAN.

# Adresse que MediaMTX appelle pour chaque publication.
# Prod : https://archilan.fr/api/v1/media-auth ; essai local : http://host.docker.internal:8000/api/v1/media-auth
MTX_AUTHHTTPADDRESS=https://archilan.fr/api/v1/media-auth

# IP LAN de la machine de régie, annoncée aux clients WebRTC (séparées par des virgules).
MTX_WEBRTCADDITIONALHOSTS=192.168.1.10

# Origines autorisées à lire en WHEP (la page de l'écran régie).
MTX_WEBRTCALLOWORIGINS=https://archilan.fr,https://www.archilan.fr
