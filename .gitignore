# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Claude Code local settings
.claude/settings.local.json
.claude/worktrees/

# Separate repos - managed independently (root-level only; anchored so nested dirs
# like frontend route group app/(public)/aide/archipelago/ are NOT ignored)
/bridge/
/orchestrateur/
/archipelago/
/packages/

# Production secrets - never commit
.env.prod
envs/*.env

# Local Mercure dev TLS certs (generated with mkcert - never commit)
/certs/*.pem

# Local generation artefacts: the apworld under test, .apsave files, generated output and
# yamls. None of it belongs to the repository, and an unignored binary here is one
# absent-minded `git add` away from a release.
/output-run/
